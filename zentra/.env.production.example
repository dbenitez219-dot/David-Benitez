# ═══ ZENTRA — variables de PRODUCCIÓN ═══  Copia a .env.production (NO lo subas al repositorio).
# Generar secretos: openssl rand -hex 32   |   clave de cifrado: openssl rand -base64 32
DOMAIN=app.tudominio.com
POSTGRES_PASSWORD=
APP_URL=https://app.tudominio.com          # obligatorio https
ENCRYPTION_KEY=                            # 32 bytes en base64; si la pierdes, los tokens de Meta guardados no se pueden descifrar
CRON_SECRET=                               # ≥ 32 caracteres
BILLING_WEBHOOK_SECRET=                    # ≥ 32 caracteres
ERROR_WEBHOOK_URL=                         # (recomendado) webhook compatible con Slack para alertas de errores

# Correo (restablecer contraseña, verificación, avisos): SIN esto esas funciones NO sirven
RESEND_API_KEY=
MAIL_FROM="ZENTRA <avisos@tudominio.com>"

# Meta Ads (ver docs/04-META-ADS.md)
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v23.0

# ZENTRA AI (opcional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# NUNCA actives esto en producción real (los pagos serían falsos): solo demostraciones
# ALLOW_SIMULATED_PAYMENTS=true
