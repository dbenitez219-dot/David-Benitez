# Copia a .env y completa. NUNCA subas .env al repositorio.
DATABASE_URL="postgresql://zentra:zentra_dev@localhost:5432/zentra"
# 32 bytes en base64: openssl rand -base64 32  (cifra los tokens de Meta)
ENCRYPTION_KEY=""
# URL pública de la app (se usa para validar el origen de las peticiones)
APP_URL="http://localhost:3000"

# ── Meta Ads (Fase 3). Sin estas variables la conexión real queda desactivada ──
META_APP_ID=""
META_APP_SECRET=""
# Versión de la Graph API; verifica la vigente en developers.facebook.com/docs/graph-api/changelog
META_API_VERSION="v23.0"
# Secreto para el endpoint de sincronización programada (/api/cron/sync): openssl rand -hex 32
CRON_SECRET=""

# ── ZENTRA AI (Fase 4). Sin clave, el asistente responde con reglas básicas ──
ANTHROPIC_API_KEY=""
# Modelo del asistente (por defecto claude-opus-5-5; puedes elegir uno más económico)
ANTHROPIC_MODEL=""

# ── Correo de avisos (Fase 5). Sin estas variables no se envían correos ──
RESEND_API_KEY=""
MAIL_FROM="ZENTRA <avisos@tu-dominio.com>"

# ── Pagos (Fase 6) ──
# Secreto para firmar/verificar webhooks de pago: openssl rand -hex 32
BILLING_WEBHOOK_SECRET=""
# En producción el proveedor de pago SIMULADO está deshabilitado; solo actívalo a propósito (para demos)
ALLOW_SIMULATED_PAYMENTS=""
