{
  "name": "zentra",
  "version": "0.1.0",
  "private": true,
  "description": "ZENTRA — Global AI Advertising Intelligence SaaS",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-flags.mjs && prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:promote": "tsx scripts/make-admin.ts",
    "postinstall": "node scripts/copy-flags.mjs",
    "admin:reset-mfa": "tsx scripts/reset-mfa.ts",
    "e2e": "node e2e/smoke.cjs",
    "loadtest": "node scripts/loadtest.mjs",
    "backup": "bash scripts/backup.sh",
    "restore:check": "bash scripts/restore-check.sh",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "countries-and-timezones": "^3.11.0",
    "country-flag-icons": "^1.6.20",
    "country-to-currency": "^3.0.2",
    "libphonenumber-js": "^1.13.16",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
